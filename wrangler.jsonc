{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./worker/entry.ts",
  "compatibility_date": "2026-07-20",
  "preview_urls": false,
  "keep_vars": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
