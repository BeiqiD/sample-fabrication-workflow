# Explicit source-only build context. An untracked file outside these source
# trees cannot accidentally enter an image layer.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!vite.node.config.ts
!tsconfig*.json
!src/
!src/**
!public/
!public/**
!shared/
!shared/**
!worker/
!worker/**
!server/
!server/**
!scripts/
!scripts/**
!migrations/
!migrations/**
!distribution/
!distribution/**
# Private data is excluded even if mistakenly placed inside a source tree.
**/.dev.vars*
**/.env*
**/*.log
**/*.tsbuildinfo
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-wal
**/*.db-shm
**/*.writer-lock
**/keyring*.json
**/storage-keyring*.json
**/credentials*.json
**/installation*.json
**/namespace-marker*.json
**/namespace.json
**/runtime.json
**/local-volume-descriptors*.json
**/private/**
**/volumes/**
**/backups/**
**/artifacts/**
